{
  "name": "game-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A better search across PC game stores (Steam, GOG, ...) with price comparison. Catalogue in Postgres.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild src/server/index.ts src/server/crawl-cli.ts src/server/migrate-cli.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outdir=dist-server --log-level=warning",
    "start": "NODE_ENV=production node dist-server/index.js",
    "migrate": "tsx src/server/migrate-cli.ts",
    "crawl": "tsx src/server/crawl-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "satori": "^0.63.0"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jersey-15": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
