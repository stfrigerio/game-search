# /srv/game-search/game-search.env — read by the server, crawl and release units.
# Outside the app folder so deploys don't replace it. chmod 600.
DATABASE_URL=postgres://game_search:CHANGE_ME@localhost/game_search
# Region for Steam/GOG prices (CheapShark comparison prices are always USD).
STORE_COUNTRY=US
STORE_CURRENCY=USD
# Steam Web API key (https://steamcommunity.com/dev/apikey) for the Library page.
# Leave unset to turn the page's lookups off.
STEAM_API_KEY=
